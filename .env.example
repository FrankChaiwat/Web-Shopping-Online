# PostgreSQL จาก pgAdmin 4: ใช้ค่าจากเมนู Server > Properties > Connection
# เปลี่ยน your_password ให้เป็นรหัสผ่าน PostgreSQL ของคุณ
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/my_eshop?schema=public"
NEXTAUTH_SECRET="replace_with_a_random_secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key_here"
STRIPE_SECRET_KEY="sk_test_your_secret_key_here"

# Admin Login
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change_this_password"
ADMIN_SESSION_SECRET="change_this_to_a_long_random_secret"

# Test Customer Login
CUSTOMER_USERNAME="frank"
CUSTOMER_PASSWORD="frank"
CUSTOMER_SESSION_SECRET="change_this_to_a_long_random_secret"
